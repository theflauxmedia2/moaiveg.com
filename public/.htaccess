RewriteEngine On
RewriteBase /

# Keep direct access for real files/directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing build files and static assets must return a real 404, never index.html.
# Serving HTML in place of a JS/CSS file makes the browser refuse it and the page goes blank.
RewriteRule ^assets/ - [R=404,L]
RewriteRule \.(js|mjs|css|map|json|png|jpe?g|gif|webp|avif|svg|ico|webm|mp4|woff2?|ttf|xml|txt)$ - [R=404,L]

# SPA fallback: send all other routes to index.html.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Always revalidate the HTML so browsers never hold an index.html that points at deleted bundles.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Built bundles have a content hash in their filename, so they can be cached forever.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
